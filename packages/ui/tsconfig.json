{
  "compilerOptions": {
    "outDir": "dist",
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "paths": {
      "@storybook-config/*": ["./.storybook/*"],
      "@repo/ui/*": ["./src/*"]
    },
    "rootDir": ".",
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "esnext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["**/*.ts", "**/*.tsx"]
}
